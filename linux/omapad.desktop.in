[Desktop Entry]
Type=Application
Name=omapad
GenericName=Text Editor
Comment=Native text editor modelled on Notepad++
Exec=@BINDIR@/omapad %F
Icon=omapad
Terminal=false
Categories=Utility;TextEditor;
MimeType=text/plain;text/x-csrc;text/x-c++src;text/x-python;text/x-shellscript;text/markdown;application/json;application/xml;text/html;text/css;application/javascript;
Keywords=notepad;notepad++;text;editor;code;
StartupWMClass=omapad
StartupNotify=true
